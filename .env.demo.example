# Copy to .env.demo.local for additive demo queue records in the EXISTING project.
# Keep SUPABASE_SERVICE_ROLE_KEY local to this script. Never use a VITE_ name.
SUPABASE_URL=https://YOUR_EXISTING_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SALON_DEMO_PROJECT_REF=YOUR_EXISTING_PROJECT_REF
SALON_DEMO_APP_URL=http://127.0.0.1:5173

# Reuse this stable key each time to avoid creating another demo batch.
DEMO_SEED_KEY=salon-queue-demo-v1

# Use three unique 10-digit test numbers that do not appear anywhere in queue history.
# The seed function checks all existing queue entries and aborts on any collision.
DEMO_CUSTOMER_PHONE_1=0000000001
DEMO_CUSTOMER_PHONE_2=0000000002
DEMO_CUSTOMER_PHONE_3=0000000003
